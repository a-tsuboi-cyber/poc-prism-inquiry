# PRISM一次受けAIアシスタント 環境設定テンプレート
# このファイルを .env にコピーし、必要に応じて値を設定してください。
# ※ GEMINI_API_KEY が未設定の場合、自動的にルールベース/モックエンジンで安全に稼働します。

PORT=3000

# Google Gemini API Key
# 取得先: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 利用するGeminiモデル名（デフォルト: gemini-3.8-flash）
GEMINI_MODEL=gemini-3.8-flash

# Microsoft Teams Incoming Webhook URL（チケット起票時のAdaptive Card通知用）
# ※ 未設定時はコンソールログにモック出力されます。
TEAMS_WEBHOOK_URL=
